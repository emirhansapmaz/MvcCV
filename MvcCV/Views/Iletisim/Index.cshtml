@using MvcCV.Models;
@model List<TblIletisim>

@{
    ViewBag.Title = "Gelen Mesajlar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="modern-card">
    <div class="modern-card-header">
        <div class="card-header-left">
            <div class="card-header-icon">
                <i class="fa-solid fa-inbox"></i>
            </div>
            <div>
                <h2 class="modern-card-title">Gelen İletişim Mesajları</h2>
                <p class="modern-card-subtitle">Portfolyo siteniz üzerinden ziyaretçilerin ilettiği mesajlar.</p>
            </div>
        </div>
        <span class="admin-badge admin-badge-primary">
            <i class="fa-solid fa-envelope"></i>
            Toplam: @Model.Count Mesaj
        </span>
    </div>

    <div class="modern-card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-regular fa-envelope-open fa-3x mb-3 text-secondary"></i>
                <h5>Henüz hiç mesaj bulunmuyor.</h5>
                <p class="small">Sitenizden gönderilen yeni mesajlar burada görüntülenecektir.</p>
            </div>
        }
        else
        {
            <div class="admin-msg-timeline">
                @foreach (var item in Model.OrderByDescending(x => x.Id))
                {
                    <div class="admin-msg-card">
                        <div class="admin-msg-header">
                            <div class="admin-msg-sender">
                                <i class="fa-solid fa-circle-user text-primary fa-lg"></i>
                                <span>@item.Kimden</span>
                                <span class="admin-msg-subject">&bull; @item.Konu</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <a href="mailto:@item.Mail" class="admin-badge admin-badge-gray text-decoration-none">
                                    <i class="fa-regular fa-envelope text-primary"></i>
                                    @item.Mail
                                </a>
                                <span class="admin-badge admin-badge-gray">
                                    <i class="fa-regular fa-clock text-primary"></i>
                                    @item.Tarih
                                </span>
                            </div>
                        </div>

                        <div class="admin-msg-body">
                            @item.Mesaj
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>