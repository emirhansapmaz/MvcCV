@{
    ViewBag.Title = "Yeni Admin Ekle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="modern-card">
    <div class="modern-card-header">
        <div class="card-header-left">
            <div class="card-header-icon">
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <div>
                <h2 class="modern-card-title">Yeni Yönetici Ekle</h2>
                <p class="modern-card-subtitle">Sisteme erişebilecek yeni bir yönetici hesabı oluşturun.</p>
            </div>
        </div>
        <a href="/Admin/Index" class="btn-modern-outline">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Listeye Dön</span>
        </a>
    </div>

    <div class="modern-card-body">
        <form method="post" action="/Admin/AdminEkle">
            <div class="form-grid-2">
                <div class="admin-form-group">
                    <label class="admin-form-label">
                        <i class="fa-solid fa-user text-primary me-1"></i> Kullanıcı Adı
                    </label>
                    <input type="text" name="KullaniciAdi" class="admin-form-control" placeholder="Örn: admin" required />
                </div>

                <div class="admin-form-group">
                    <label class="admin-form-label">
                        <i class="fa-solid fa-key text-primary me-1"></i> Şifre
                    </label>
                    <input type="password" name="Sifre" class="admin-form-control" placeholder="Güçlü bir şifre girin" required />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="/Admin/Index" class="btn-modern-outline">İptal</a>
                <button type="submit" class="btn-modern-primary">
                    <i class="fa-solid fa-check"></i>
                    <span>Yöneticiyi Kaydet</span>
                </button>
            </div>
        </form>
    </div>
</div>