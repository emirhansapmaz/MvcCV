@{
    ViewBag.Title = "AdminEkle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<h4>Yeni Admin Ekleme Sayfası</h4>
<form class="form-group" method="post" action="/Admin/AdminEkle">
    <br />
    <input type="text" name="KullaniciAdi" class="form-control" placeholder="Kullanıcı Adı" />
    <br />
    <input type="text" name="Sifre" class="form-control" placeholder="Şifre girin" />
    <br />
    <button type="submit" class="btn btn-primary">Admin Ekle</button>
</form> 