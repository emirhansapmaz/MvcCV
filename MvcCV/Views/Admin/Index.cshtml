@using MvcCV.Models;
@model List<TblAdmin>

@{
    ViewBag.Title = "Admin Ayarları";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="modern-card">
    <div class="modern-card-header">
        <div class="card-header-left">
            <div class="card-header-icon">
                <i class="fa-solid fa-users-gear"></i>
            </div>
            <div>
                <h2 class="modern-card-title">Yönetici Hesapları</h2>
                <p class="modern-card-subtitle">Yönetim paneline erişim yetkisine sahip kullanıcıları yönetin.</p>
            </div>
        </div>
        <a href="/Admin/AdminEkle" class="btn-modern-primary">
            <i class="fa-solid fa-user-plus"></i>
            <span>Yeni Admin Ekle</span>
        </a>
    </div>

    <div class="modern-card-body p-0">
        <div class="modern-table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Kullanıcı Adı</th>
                        <th>Erişim Rolü</th>
                        <th style="width: 170px;" class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="admin-badge admin-badge-gray">#@item.Id</span></td>
                            <td class="fw-bold text-dark">
                                <i class="fa-solid fa-circle-user text-primary me-2"></i>
                                @item.KullaniciAdi
                            </td>
                            <td>
                                <span class="admin-badge admin-badge-primary">
                                    <i class="fa-solid fa-shield-halved"></i> Tam Yetkili Yönetici
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a href="/Admin/AdminGetir/@item.Id" class="btn-action-edit" title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                        <span>Düzenle</span>
                                    </a>
                                    <a href="/Admin/AdminSil/@item.Id" class="btn-action-delete" title="Sil" onclick="return confirm('Bu yönetici hesabını silmek istediğinize emin misiniz?');">
                                        <i class="fa-solid fa-trash-can"></i>
                                        <span>Sil</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>