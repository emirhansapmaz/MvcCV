@using MvcCV.Models;
@model List<TblAdmin>


@*
    
*@
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<h2>Deneyim Listesi</h2>
<
    <table class="table table-bordered table-striped">
        
<tr>
    <th>ID</th>
    <th>Kullanıcı Adı</th>
    <th>Düzenle</th>
    <th>Kaldır</th>
    
</tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.KullaniciAdi</td>
            <td>
                <a href="/Admin/AdminGetir/@item.Id" class="btn btn-warning">Düzenle</a>
                
            </td>
            <td>
                <a href="/Admin/AdminSil/@item.Id" class="btn btn-danger">Sil</a>
</td>
        </tr>
        }
      
    
</table>

    <div class="mt-3">
        <a href="/Admin/AdminEkle" class="btn btn-primary">Yeni Admin Ekle</a>
    </div>