@model MvcCV.Models.TblAdmin

@{
    ViewBag.Title = "Admin Güncelle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="modern-card">
    <div class="modern-card-header">
        <div class="card-header-left">
            <div class="card-header-icon">
                <i class="fa-solid fa-user-pen"></i>
            </div>
            <div>
                <h2 class="modern-card-title">Yönetici Bilgilerini Güncelle</h2>
                <p class="modern-card-subtitle">Kullanıcı adı ve şifre bilgilerini güncelleyin.</p>
            </div>
        </div>
        <a href="/Admin/Index" class="btn-modern-outline">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Listeye Dön</span>
        </a>
    </div>

    <div class="modern-card-body">
        <form method="post">
            @Html.HiddenFor(x => x.Id)

            <div class="form-grid-2">
                <div class="admin-form-group">
                    @Html.Label("KullaniciAdi", "Kullanıcı Adı", new { @class = "admin-form-label" })
                    @Html.TextBoxFor(x => x.KullaniciAdi, new { @class = "admin-form-control", placeholder = "Kullanıcı adı" })
                </div>

                <div class="admin-form-group">
                    @Html.Label("Sifre", "Şifre", new { @class = "admin-form-label" })
                    @Html.TextBoxFor(x => x.Sifre, new { @class = "admin-form-control", placeholder = "Şifre" })
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="/Admin/Index" class="btn-modern-outline">İptal</a>
                <button type="submit" class="btn-modern-success">
                    <i class="fa-solid fa-check"></i>
                    <span>Güncellemeyi Kaydet</span>
                </button>
            </div>
        </form>
    </div>
</div>