@model MvcCV.Models.TblEgitim;

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewBag.Title = "EgitimDuzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<h4>Eğitim Güncelleme Sayfası</h4>
<form method="post">
    @Html.Label("Eğitim ID")
    @Html.TextBoxFor(x => x.Id, new { @class = "form-control" })
<br />
    @Html.Label("Başlık")
    @Html.TextBoxFor(x => x.Baslik, new { @class = "form-control" })
    <br />
    @Html.Label("Alt Başlık")
    @Html.TextBoxFor(x => x.AltBaslik, new { @class = "form-control" })
    <br />
    @Html.Label("GNO")
    @Html.TextBoxFor(x => x.Gno, new { @class = "form-control" })
    <br />
     @Html.Label("Tarih")
    @Html.TextBoxFor(x => x.Tarih, new { @class = "form-control" })
    <br />
    <button type="submit" class="btn btn-primary">Eğitim Güncelle</button>
</form> 