@model MvcCV.Models.TblEgitim;

@{
    ViewBag.Title = "Eğitim Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="modern-card">
    <div class="modern-card-header">
        <div class="card-header-left">
            <div class="card-header-icon">
                <i class="fa-solid fa-pen-to-square"></i>
            </div>
            <div>
                <h2 class="modern-card-title">Eğitim Bilgisi Güncelle</h2>
                <p class="modern-card-subtitle">Mevcut okul veya diploma kaydınızı güncelleyin.</p>
            </div>
        </div>
        <a href="/Egitim/Index" class="btn-modern-outline">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Listeye Dön</span>
        </a>
    </div>

    <div class="modern-card-body">
        <form method="post">
            @Html.HiddenFor(x => x.Id)

            <div class="form-grid-2">
                <div class="admin-form-group">
                    @Html.Label("Başlık", "Okul / Üniversite Adı", new { @class = "admin-form-label" })
                    @Html.TextBoxFor(x => x.Baslik, new { @class = "admin-form-control", placeholder = "Okul adı" })
                </div>

                <div class="admin-form-group">
                    @Html.Label("AltBaslik", "Bölüm / Fakülte", new { @class = "admin-form-label" })
                    @Html.TextBoxFor(x => x.AltBaslik, new { @class = "admin-form-control", placeholder = "Bölüm adı" })
                </div>

                <div class="admin-form-group">
                    @Html.Label("AltBaslik2", "Derece / Detay Bilgisi", new { @class = "admin-form-label" })
                    @Html.TextBoxFor(x => x.AltBaslik2, new { @class = "admin-form-control", placeholder = "Örn: Lisans" })
                </div>

                <div class="admin-form-group">
                    @Html.Label("Gno", "Genel Not Ortalaması (GNO)", new { @class = "admin-form-label" })
                    @Html.TextBoxFor(x => x.Gno, new { @class = "admin-form-control", placeholder = "Örn: 3.50" })
                </div>
            </div>

            <div class="admin-form-group">
                @Html.Label("Tarih", "Öğrenim Tarihleri", new { @class = "admin-form-label" })
                @Html.TextBoxFor(x => x.Tarih, new { @class = "admin-form-control", placeholder = "Örn: 2018 - 2022" })
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="/Egitim/Index" class="btn-modern-outline">İptal</a>
                <button type="submit" class="btn-modern-success">
                    <i class="fa-solid fa-check"></i>
                    <span>Güncellemeyi Kaydet</span>
                </button>
            </div>
        </form>
    </div>
</div>