@using MvcCV.Models;
@model List<TblEgitim>

@{
    ViewBag.Title = "Eğitim Listesi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="modern-card">
    <div class="modern-card-header">
        <div class="card-header-left">
            <div class="card-header-icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <div>
                <h2 class="modern-card-title">Eğitim Listesi</h2>
                <p class="modern-card-subtitle">Öğrenim geçmişinizi ve akademik derecelerinizi bu panelden düzenleyin.</p>
            </div>
        </div>
        <a href="/Egitim/EgitimEkle" class="btn-modern-primary">
            <i class="fa-solid fa-plus"></i>
            <span>Yeni Eğitim Ekle</span>
        </a>
    </div>

    <div class="modern-card-body p-0">
        <div class="modern-table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Okul / Kurum</th>
                        <th>Bölüm / Fakülte</th>
                        <th>Detay / Not</th>
                        <th>GNO</th>
                        <th>Mezuniyet Tarihi</th>
                        <th style="width: 170px;" class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="admin-badge admin-badge-gray">#@item.Id</span></td>
                            <td class="fw-bold text-dark">@item.Baslik</td>
                            <td><span class="admin-badge admin-badge-primary">@item.AltBaslik</span></td>
                            <td class="text-muted">@item.AltBaslik2</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Gno))
                                {
                                    <span class="admin-badge admin-badge-success">
                                        <i class="fa-solid fa-star"></i>
                                        @item.Gno
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="admin-badge admin-badge-gray">
                                    <i class="fa-regular fa-calendar-check text-primary"></i>
                                    @item.Tarih
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a href="/Egitim/EgitimDuzenle/@item.Id" class="btn-action-edit" title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                        <span>Düzenle</span>
                                    </a>
                                    <a href="/Egitim/EgitimSil/@item.Id" class="btn-action-delete" title="Sil" onclick="return confirm('Bu eğitim kaydını silmek istediğinize emin misiniz?');">
                                        <i class="fa-solid fa-trash-can"></i>
                                        <span>Sil</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
