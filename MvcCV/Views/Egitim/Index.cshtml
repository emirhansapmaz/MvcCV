@using MvcCV.Models;
@model List<TblEgitim>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
    
<br />
<h2>Eğitim Listesi</h2>

<!-- Fazladan olan '<' işareti kaldırıldı -->
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Başlık</th>
            <th>Alt Başlık</th>
            <th>Alt Başlık 2</th>
            <th>GNO</th>
            <th>Tarih</th>
            <th>İşlemler</th> <!-- Eksik olan 6. başlık eklendi -->
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Baslik</td>
                <td>@item.AltBaslik</td>
                <td>@item.AltBaslik2</td>
                <td>@item.Gno</td>
                <td>@item.Tarih</td>
                <td>
                    <a href="/Egitim/EgitimDuzenle/@item.Id" class="btn btn-warning btn-sm">Düzenle</a>
                    <a href="/Egitim/EgitimSil/@item.Id" class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a href="/Egitim/EgitimEkle" class="btn btn-primary">Yeni Eğitim Ekle</a>
</div>

