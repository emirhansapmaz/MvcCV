@using MvcCV.Models;
@model List<TblDeneyim>

@{
    ViewBag.Title = "Deneyim Listesi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="modern-card">
    <div class="modern-card-header">
        <div class="card-header-left">
            <div class="card-header-icon">
                <i class="fa-solid fa-briefcase"></i>
            </div>
            <div>
                <h2 class="modern-card-title">Deneyim Listesi</h2>
                <p class="modern-card-subtitle">İş ve staj tecrübelerinizi bu ekrandan yönetebilirsiniz.</p>
            </div>
        </div>
        <a href="/Deneyim/DeneyimEkle" class="btn-modern-primary">
            <i class="fa-solid fa-plus"></i>
            <span>Yeni Deneyim Ekle</span>
        </a>
    </div>

    <div class="modern-card-body p-0">
        <div class="modern-table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Pozisyon / Başlık</th>
                        <th>Şirket / Alt Başlık</th>
                        <th>Çalışma Tarihi</th>
                        <th style="width: 170px;" class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="admin-badge admin-badge-gray">#@item.Id</span></td>
                            <td class="fw-bold text-dark">@item.Baslik</td>
                            <td><span class="admin-badge admin-badge-primary">@item.AltBaslik</span></td>
                            <td>
                                <span class="admin-badge admin-badge-gray">
                                    <i class="fa-regular fa-calendar-days text-primary"></i>
                                    @item.Tarih
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a href="/Deneyim/DeneyimGetir/@item.Id" class="btn-action-edit" title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                        <span>Düzenle</span>
                                    </a>
                                    <a href="/Deneyim/DeneyimSil/@item.Id" class="btn-action-delete" title="Sil" onclick="return confirm('Bu deneyimi silmek istediğinize emin misiniz?');">
                                        <i class="fa-solid fa-trash-can"></i>
                                        <span>Sil</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>