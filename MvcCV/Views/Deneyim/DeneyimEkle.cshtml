@{
    ViewBag.Title = "DeneyimEkle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<h4>Yeni Deneyim Ekleme Sayfası</h4>
<form class="form-group" method="post" action="/Deneyim/DeneyimEkle">
    <br />
    <input type="text" name="Baslik" class="form-control" placeholder="Başlık girin" />
    <br />
    <input type="text" name="AltBaslik" class="form-control" placeholder="Alt başlık girin" />
    <br />
    <input type="text" name="Tarih" class="form-control" placeholder="Tarih girin" />
    <br />
    <button type="submit" class="btn btn-primary">Deneyim Ekle</button>
</form> 