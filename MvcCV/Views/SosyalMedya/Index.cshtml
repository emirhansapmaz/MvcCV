@using MvcCV.Models;
@model List<TblSosyalMedya>


@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!DOCTYPE html>
<html>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <!-- Navbar -->
        <!-- Main content -->
        <section class="content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Sosyal Medya Hesap Listem</h3>
                            </div>
                            <!-- /.card-header -->
                            <div class="card-body">
                                <button  class="btn btn-info" data-toggle="modal" data-target="#modal1">
                                    Yeni Sosyal Medya Hesabı Ekle
                                </button>
                                <br />
                                <br />
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            
                                            <th>Sosyal Medya</th>
                                            <th>Düzenle</th>
                                            <th>Sil</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)                      {
                                            <tr>
                                                
                                                <td>@item.Ad</td>
                                              
                                              
                                                <td>
                                                    <a class="btn btn-info btn-sm" href="/SosyalMedya/SosyalMedyaGuncelle/@item.Id">
                                                        <i class="fas fa-pencil-alt">
                                                        </i>
                                                        Düzenle
                                                    </a>
                                                </td>
                                                <td>
                                                    <a class="btn btn-danger btn-sm" href="/SosyalMedya/Sil/@item.Id">
                                                        <i class="fas fa-trash">
                                                        </i>
                                                        Sil
                                                    </a>
                                                </td>
                                            </tr>
                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- /.card -->
                    </div>
                </div>
            </div><!-- /.container-fluid -->
        </section>

    <div class="modal" id="modal1">
        <div class="modal-dialog">
        <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title">Yeni Sosyal Medya Hesabı Ekleme Paneli</h4>
            

</div>
                    <form method="post" action="/SosyalMedya/SosyalMedyaEkle">
                        <div class="modal-body">
                            <div class="form-group">
                                <label for="ad">Sosyal Medya Adı</label>
                                <input type="text" class="form-control" id="ad" name="Ad" placeholder="Sosyal Medya Adı">
                            </div>

                            <div class="form-group">
                                <label for="link">Sosyal Medya Linki</label>
                                <input type="text" class="form-control" id="link" name="Link" placeholder="Sosyal Medya Linki">
                            </div>

                            <!-- İkon kısmı modal-body içine taşındı -->
                            <div class="form-group">
                                <label for="ikon">Sosyal Medya İkonu</label>
                                <input type="text" class="form-control" id="ikon" name="Ikon" placeholder="Sosyal Medya İkonu">
                            </div>
                        </div> <!-- modal-body burada kapanıyor -->

                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal">Kapat</button>
                            <button type="submit" class="btn btn-primary">Ekle</button>
                        </div>
                    </form>
   </div>


</div>
        <!-- /.content -->
    </div>
</body>
</html>