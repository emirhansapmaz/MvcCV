@using MvcCV.Models;
@model List<TblDeneyim>

<div class="modern-timeline">
    @foreach (var x in Model)
    {
        <div class="timeline-card">
            <div class="timeline-header">
                <div>
                    <h3 class="timeline-title">@x.Baslik</h3>
                    <div class="timeline-subheading">
                        <i class="fa-solid fa-briefcase"></i>
                        <span>@x.AltBaslik</span>
                    </div>
                </div>
                <div class="timeline-date-chip">
                    <i class="fa-regular fa-calendar"></i>
                    <span>@x.Tarih</span>
                </div>
            </div>
            <p class="timeline-body-text">@x.Aciklama</p>
        </div>
    }
</div>