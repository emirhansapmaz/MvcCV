@using MvcCV.Models;
@model List<TblEgitim>

<div class="modern-timeline">
    @foreach (var x in Model)
    {
        <div class="timeline-card">
            <div class="timeline-header">
                <div>
                    <h3 class="timeline-title">@x.Baslik</h3>
                    <div class="timeline-subheading">
                        <i class="fa-solid fa-graduation-cap"></i>
                        <span>@x.AltBaslik</span>
                    </div>
                    @if (!string.IsNullOrEmpty(x.AltBaslik2))
                    {
                        <div class="edu-sub2">@x.AltBaslik2</div>
                    }
                </div>
                <div class="d-flex flex-column align-items-end gap-2">
                    <div class="timeline-date-chip">
                        <i class="fa-regular fa-calendar-check"></i>
                        <span>@x.Tarih</span>
                    </div>
                    @if (!string.IsNullOrEmpty(x.Gno))
                    {
                        <div class="gno-badge">
                            <i class="fa-solid fa-star"></i>
                            <span>GNO: @x.Gno</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
