@using MvcCV.Models;
@model List<TblHakkindum>

@{
    Layout = null;
    var profile = Model?.FirstOrDefault();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Kişisel CV ve Portfolyo Web Sitesi" />
    <title>@(profile != null ? $"{profile.Ad} {profile.Soyad} | CV & Portfolyo" : "CV & Portfolyo")</title>
    <link rel="icon" type="image/x-icon" href="~/assets/img/favicon.ico" />
    
    <!-- Google Fonts: Plus Jakarta Sans & Space Grotesk -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- Core Bootstrap & Modern CV Stylesheet -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/modern-cv.css" rel="stylesheet" />
</head>
<body id="page-top">

    <!-- Navigation / Sidebar -->
    <nav class="modern-sidebar" id="sideNav">
        <!-- Sidebar Profile Header -->
        <div class="sidebar-profile">
            <div class="profile-avatar-wrap">
                <img class="img-profile" 
                     src="@(string.IsNullOrEmpty(profile?.Resim) ? Url.Content("~/assets/img/profile.jpg") : profile.Resim)" 
                     alt="@(profile != null ? $"{profile.Ad} {profile.Soyad}" : "Profil")" />
                <div class="status-badge">
                    <span class="status-dot"></span>
                    <span>Müsait</span>
                </div>
            </div>
            <div class="sidebar-title">@(profile != null ? $"{profile.Ad} {profile.Soyad}" : "Portfolyo")</div>
            <div class="sidebar-role">Yazılım Geliştirici</div>
        </div>

        <!-- Mobile Header Brand -->
        <a class="navbar-brand d-lg-none fw-bold text-white d-flex align-items-center gap-2" href="#page-top">
            <img class="rounded-circle border border-2 border-primary" 
                 style="width: 38px; height: 38px; object-fit: cover;" 
                 src="@(string.IsNullOrEmpty(profile?.Resim) ? Url.Content("~/assets/img/profile.jpg") : profile.Resim)" 
                 alt="Profil" />
            <span>@(profile != null ? $"{profile.Ad} {profile.Soyad}" : "Portfolyo")</span>
        </a>

        <!-- Mobile Hamburger Button -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Menüyü Aç/Kapat">
            <i class="fa-solid fa-bars"></i>
        </button>

        <!-- Navigation Menu Items -->
        <div class="collapse navbar-collapse" id="navbarResponsive">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link active" href="#about">
                        <i class="fa-solid fa-user"></i>
                        <span>Hakkımda</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#experience">
                        <i class="fa-solid fa-briefcase"></i>
                        <span>Deneyim</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#education">
                        <i class="fa-solid fa-graduation-cap"></i>
                        <span>Eğitim</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#skills">
                        <i class="fa-solid fa-code"></i>
                        <span>Yetenekler</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#interests">
                        <i class="fa-solid fa-heart"></i>
                        <span>İlgi Alanları</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#awards">
                        <i class="fa-solid fa-award"></i>
                        <span>Sertifikalar</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#contact">
                        <i class="fa-solid fa-paper-plane"></i>
                        <span>İletişim</span>
                    </a>
                </li>
            </ul>

            <!-- Admin Panel Quick Link -->
            <div class="sidebar-footer">
                <a href="/Login/Index" class="btn-sidebar-admin">
                    <i class="fa-solid fa-lock"></i>
                    <span>Admin Paneli</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Content Wrapper -->
    <div class="page-wrapper">
        <div class="content-container">

            <!-- Section 1: About / Hakkımda -->
            @if (Model != null)
            {
                @foreach (var x in Model)
                {
                    <section class="resume-section" id="about">
                    <div class="section-tag">
                        <i class="fa-solid fa-sparkles"></i>
                        <span>Kişisel CV & Portfolyo</span>
                    </div>

                    <h1 class="hero-heading">
                        @x.Ad
                        <span class="gradient-text">@x.Soyad</span>
                    </h1>

                    <div class="hero-meta-list">
                        @if (!string.IsNullOrEmpty(x.Adres))
                        {
                            <span class="hero-meta-pill">
                                <i class="fa-solid fa-location-dot"></i>
                                <span>@x.Adres</span>
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(x.Mail))
                        {
                            <a href="mailto:@x.Mail" class="hero-meta-pill">
                                <i class="fa-solid fa-envelope"></i>
                                <span>@x.Mail</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(x.Telefon))
                        {
                            <a href="tel:@x.Telefon" class="hero-meta-pill">
                                <i class="fa-solid fa-phone"></i>
                                <span>@x.Telefon</span>
                            </a>
                        }
                    </div>

                    <div class="hero-bio-card">
                        <p class="hero-bio-text">@x.Aciklama</p>
                    </div>

                    <!-- Social Media ViewComponent -->
                    @await Component.InvokeAsync("SosyalMedya")

                    <div class="hero-actions">
                        <a href="#contact" class="btn-primary-gradient">
                            <i class="fa-solid fa-paper-plane"></i>
                            <span>İletişime Geç</span>
                        </a>
                        <a href="#experience" class="btn-glass">
                            <i class="fa-solid fa-layer-group"></i>
                            <span>Deneyimleri İncele</span>
                        </a>
                    </div>
                </section>
                }
            }

            <hr class="section-divider" />

            <!-- Section 2: Experience / Deneyim -->
            <section class="resume-section" id="experience">
                <div class="section-tag">
                    <i class="fa-solid fa-briefcase"></i>
                    <span>Kariyer</span>
                </div>
                <h2 class="section-title">
                    <i class="fa-solid fa-business-time"></i>
                    <span>İş Deneyimleri</span>
                </h2>
                @await Component.InvokeAsync("Deneyim")
            </section>

            <hr class="section-divider" />

            <!-- Section 3: Education / Eğitim -->
            <section class="resume-section" id="education">
                <div class="section-tag">
                    <i class="fa-solid fa-graduation-cap"></i>
                    <span>Eğitim Geçmişi</span>
                </div>
                <h2 class="section-title">
                    <i class="fa-solid fa-building-columns"></i>
                    <span>Eğitim Hayatım</span>
                </h2>
                @await Component.InvokeAsync("Egitim")
            </section>

            <hr class="section-divider" />

            <!-- Section 4: Skills / Yetenekler -->
            <section class="resume-section" id="skills">
                <div class="section-tag">
                    <i class="fa-solid fa-code"></i>
                    <span>Uzmanlıklar</span>
                </div>
                <h2 class="section-title">
                    <i class="fa-solid fa-laptop-code"></i>
                    <span>Yetenekler & Teknolojiler</span>
                </h2>
                @await Component.InvokeAsync("Yetenek")
            </section>

            <hr class="section-divider" />

            <!-- Section 5: Interests / Hobiler -->
            <section class="resume-section" id="interests">
                <div class="section-tag">
                    <i class="fa-solid fa-heart"></i>
                    <span>Kişisel</span>
                </div>
                <h2 class="section-title">
                    <i class="fa-solid fa-compass"></i>
                    <span>İlgi Alanlarım & Hobiler</span>
                </h2>
                @await Component.InvokeAsync("Hobi")
            </section>

            <hr class="section-divider" />

            <!-- Section 6: Awards / Sertifikalar -->
            <section class="resume-section" id="awards">
                <div class="section-tag">
                    <i class="fa-solid fa-award"></i>
                    <span>Başarılar</span>
                </div>
                <h2 class="section-title">
                    <i class="fa-solid fa-trophy"></i>
                    <span>Sertifikalar & Ödüller</span>
                </h2>
                @await Component.InvokeAsync("Sertifika")
            </section>

            <hr class="section-divider" />

            <!-- Section 7: Contact / İletişim -->
            <section class="resume-section" id="contact">
                <div class="section-tag">
                    <i class="fa-solid fa-envelope-open-text"></i>
                    <span>Bağlantı Kur</span>
                </div>
                <h2 class="section-title">
                    <i class="fa-solid fa-paper-plane"></i>
                    <span>Bana Ulaşın</span>
                </h2>
                @await Component.InvokeAsync("Iletisim")
            </section>

            <!-- Modern Footer -->
            <footer class="modern-footer">
                <p class="mb-1">
                    &copy; @DateTime.Now.Year - @(profile != null ? $"{profile.Ad} {profile.Soyad}" : "CV Portfolyo"). Tüm hakları saklıdır.
                </p>
                <p class="text-muted small mb-0">
                    Modern UI/UX ile tasarlandı &bull; <a href="/Login/Index">Yönetim Paneli</a>
                </p>
            </footer>

        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/modern-cv.js"></script>
</body>
</html>
