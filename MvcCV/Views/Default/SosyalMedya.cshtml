@using MvcCV.Models;
@model List<TblSosyalMedya>

<div class="social-icons-wrapper">
    @foreach (var item in Model)
    {
        if (item.Durum != false)
        {
            <a class="modern-social-btn" 
               href="@item.Link" 
               target="_blank" 
               rel="noopener noreferrer" 
               title="@item.Ad"
               aria-label="@item.Ad">
                <i class="@item.Icon"></i>
            </a>
        }
    }
</div>