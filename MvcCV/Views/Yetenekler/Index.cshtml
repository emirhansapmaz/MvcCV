@using MvcCV.Models;
@model List<TblYetenekler>

@{
    ViewBag.Title = "Yetenek Listesi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="modern-card">
    <div class="modern-card-header">
        <div class="card-header-left">
            <div class="card-header-icon">
                <i class="fa-solid fa-code"></i>
            </div>
            <div>
                <h2 class="modern-card-title">Yetenek & Beceri Listem</h2>
                <p class="modern-card-subtitle">Teknik yetkinliklerinizi ve seviye oranlarını bu ekrandan yönetin.</p>
            </div>
        </div>
        <a href="/Yetenekler/YetenekEkle/" class="btn-modern-primary">
            <i class="fa-solid fa-plus"></i>
            <span>Yeni Yetenek Ekle</span>
        </a>
    </div>

    <div class="modern-card-body p-0">
        <div class="modern-table-responsive">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Yetenek Adı</th>
                        <th style="min-width: 200px;">Seviye Çubuğu</th>
                        <th style="width: 90px;">Oran</th>
                        <th style="width: 170px;" class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var oran = item.Oran ?? 0;
                        string badgeClass = oran < 35 ? "admin-badge-danger" : (oran < 70 ? "admin-badge-warning" : "admin-badge-success");
                        string barGradient = oran < 35 ? "#ef4444" : (oran < 70 ? "#f59e0b" : "#10b981");

                        <tr>
                            <td><span class="admin-badge admin-badge-gray">#@item.Id</span></td>
                            <td class="fw-bold text-dark">
                                <i class="fa-solid fa-code-commit text-primary me-2"></i>
                                @item.Yetenek
                            </td>
                            <td>
                                <div style="height: 8px; width: 100%; background-color: #f1f5f9; border-radius: 9999px; overflow: hidden;">
                                    <div style="height: 100%; width: @oran%; background-color: @barGradient; border-radius: 9999px; transition: width 0.6s ease;"></div>
                                </div>
                            </td>
                            <td>
                                <span class="admin-badge @badgeClass">@oran%</span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a href="/Yetenekler/YetenekDuzenle/@item.Id" class="btn-action-edit" title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                        <span>Düzenle</span>
                                    </a>
                                    <a href="/Yetenekler/YetenekSil/@item.Id" class="btn-action-delete" title="Sil" onclick="return confirm('Bu yeteneği silmek istediğinize emin misiniz?');">
                                        <i class="fa-solid fa-trash-can"></i>
                                        <span>Sil</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>