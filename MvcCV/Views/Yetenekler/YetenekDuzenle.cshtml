@model MvcCV.Models.TblYetenekler;

@{
    ViewBag.Title = "Yetenek Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="modern-card">
    <div class="modern-card-header">
        <div class="card-header-left">
            <div class="card-header-icon">
                <i class="fa-solid fa-pen-to-square"></i>
            </div>
            <div>
                <h2 class="modern-card-title">Yetenek Güncelle</h2>
                <p class="modern-card-subtitle">Mevcut teknik beceriyi ve seviye oranını güncelleyin.</p>
            </div>
        </div>
        <a href="/Yetenekler/Index" class="btn-modern-outline">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Listeye Dön</span>
        </a>
    </div>

    <div class="modern-card-body">
        <form method="post">
            @Html.HiddenFor(x => x.Id)

            <div class="form-grid-2">
                <div class="admin-form-group">
                    @Html.Label("Yetenek", "Yetenek Açıklaması", new { @class = "admin-form-label" })
                    @Html.TextBoxFor(x => x.Yetenek, new { @class = "admin-form-control", placeholder = "Yetenek adı" })
                </div>

                <div class="admin-form-group">
                    @Html.Label("Oran", "Yetkinlik Yüzdesi (0 - 100)", new { @class = "admin-form-label" })
                    @Html.TextBoxFor(x => x.Oran, new { @class = "admin-form-control", placeholder = "Derece oranı", type = "number", min = "0", max = "100" })
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="/Yetenekler/Index" class="btn-modern-outline">İptal</a>
                <button type="submit" class="btn-modern-success">
                    <i class="fa-solid fa-check"></i>
                    <span>Güncellemeyi Kaydet</span>
                </button>
            </div>
        </form>
    </div>
</div>